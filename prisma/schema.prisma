// Modelo de datos de caja-inventario.
//
// Reglas que este schema hace cumplir y que no son obvias a primera vista:
//
// 1. TODO el dinero se guarda en centavos enteros. Nunca Decimal, nunca Float.
//    Sumar 0.1 + 0.2 en punto flotante da 0.30000000000000004 y una caja que no
//    cierra. Entero no tiene ese problema.
//
// 2. `Producto.stock` es el stock autoritativo y `MovimientoStock` es el libro
//    mayor. Duplicar parece redundancia, pero es lo que permite bloquear la fila
//    con SELECT ... FOR UPDATE dentro de la transacción de venta, y lo que hace
//    el historial reconstruible.
//
// 3. `LineaVenta.precioUnitarioCentavos` congela el precio del momento. Si el
//    producto cambia de precio mañana, las ventas de ayer no se mueven.
//
// 4. La API pública no comparte credencial con la UI: `TokenApi` guarda sólo el
//    SHA-256 del token. El valor en claro existe una vez, al emitirlo, y no es
//    recuperable. `prefijo` permite nombrar el token en un log sin poder usarlo.

generator client {
  // Prisma 7: generador nuevo con salida explícita. El cliente se importa desde
  // ../../generated/prisma, no desde @prisma/client.
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Sin `url`: Prisma 7 la movió a prisma7.config.ts (migraciones) y al driver
  // adapter de src/lib/db.ts (runtime).
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
}

enum ScopeApi {
  PRODUCTOS_READ
  PRODUCTOS_WRITE
  VENTAS_READ
  VENTAS_WRITE
  REPORTES_READ
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  nombre       String
  // Hash bcrypt. La contraseña en claro no existe en ningún lado del sistema.
  passwordHash String
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ventas Venta[]
  tokens TokenApi[]
}

// Credencial de la API pública. Independiente de la cookie de sesión del panel:
// un token filtrado no da acceso a la UI, y cerrar sesión en la UI no lo revoca.
model TokenApi {
  id String @id @default(cuid())
  // Etiqueta humana para saber cuál es cuál: "asistente-evals", "postman".
  nombre String
  // SHA-256 del token en claro, en hexadecimal. El token en claro no se guarda.
  hash    String @unique
  // Primeros caracteres, para poder identificarlo en un log o en un listado
  // sin revelar nada reutilizable.
  prefijo String
  // Scopes como enum de Postgres y no un string: un valor inválido no entra a la
  // base, y agregar un scope es una migración, no un typo silencioso.
  scopes ScopeApi[]
  // Nullable = sin vencimiento. La emisión por defecto pone uno.
  expiraEn    DateTime?
  revocadoEn  DateTime?
  ultimoUsoEn DateTime?
  // Cupo por ventana de un minuto, copiado al token para poder ajustarlo por
  // credencial sin redeploy.
  limitePorMinuto Int      @default(60)
  createdAt       DateTime @default(now())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  usos UsoTokenApi[]

  @@index([usuarioId])
}

// Contador de rate limit. La fila compuesta ES el contador de la ventana, así que
// el incremento es un único INSERT ... ON CONFLICT DO UPDATE ... RETURNING: dos
// instancias del servidor no pueden contar de menos. En memoria no serviría, porque
// el deploy corre en varias instancias y cada una tendría su propio contador.
model UsoTokenApi {
  tokenId String
  token   TokenApi @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  // Inicio de la ventana de un minuto, truncado a segundos.
  ventana DateTime
  usos    Int      @default(0)

  @@id([tokenId, ventana])
  @@index([ventana])
}

/// Contador diario de llamadas al modelo del asistente.
///
/// No se reusa `UsoTokenApi` porque cuenta otra cosa: aquel limita pedidos por
/// minuto a la API, éste limita llamadas al modelo por día, que son las que cuestan
/// plata y las que pueden vaciar un plan. La fecha es la clave: una fila por día y el
/// incremento es un único INSERT ... ON CONFLICT DO UPDATE ... RETURNING, así que dos
/// instancias del servidor no pueden contar de menos.
model UsoModeloDiario {
  fecha    DateTime @id @db.Date
  llamadas Int      @default(0)
}

model Producto {
  id             String   @id @default(cuid())
  sku            String   @unique
  nombre         String
  precioCentavos Int
  // Stock actual. Entero: no existen medias unidades.
  stock          Int      @default(0)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  movimientos MovimientoStock[]
  lineas      LineaVenta[]

  @@index([activo, nombre])
}

model MovimientoStock {
  id         String         @id @default(cuid())
  productoId String
  producto   Producto       @relation(fields: [productoId], references: [id], onDelete: Restrict)
  tipo       TipoMovimiento
  // Siempre positivo: el signo lo determina `tipo`. Guardar -5 en una SALIDA
  // invita a que alguien lo sume dos veces.
  cantidad   Int
  // Stock resultante después del movimiento, para auditar sin recalcular toda
  // la historia del producto.
  stockLuego Int
  motivo     String?
  ventaId    String?
  venta      Venta?         @relation(fields: [ventaId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())

  @@index([productoId, createdAt])
}

model Venta {
  id                String   @id @default(cuid())
  // Número legible para el comprobante; el id cuid es interno.
  numero            Int      @unique @default(autoincrement())
  usuarioId         String
  usuario           Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  totalCentavos     Int
  // Clave que manda el cliente para que un reenvío del mismo formulario no cree
  // una segunda venta. Nullable porque las ventas históricas no la tienen, y
  // Postgres admite varios NULL en un índice único.
  claveIdempotencia String?  @unique
  createdAt         DateTime @default(now())

  lineas      LineaVenta[]
  pagos       Pago[]
  movimientos MovimientoStock[]

  @@index([createdAt])
}

model LineaVenta {
  id                     String   @id @default(cuid())
  ventaId                String
  venta                  Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId             String
  producto               Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  cantidad               Int
  // Precio congelado al momento de la venta, no una referencia al actual.
  precioUnitarioCentavos Int
  subtotalCentavos       Int
  createdAt              DateTime @default(now())

  @@index([ventaId])
  @@index([productoId])
}

model Pago {
  id            String    @id @default(cuid())
  ventaId       String
  venta         Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  medio         MedioPago
  montoCentavos Int
  createdAt     DateTime  @default(now())

  @@index([ventaId])
  @@index([createdAt, medio])
}
